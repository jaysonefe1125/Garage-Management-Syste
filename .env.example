# Copy this file to .env and fill in real values. Never commit the real .env file.

# Postgres connection string. Locally and in production this can be the same
# hosted database (e.g. Neon, or Vercel's own Storage tab which is Neon under
# the hood). See README.md for how to get this.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Any long random string. Used to encrypt the login session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-string"

# Auto-filled by Vercel when you connect a Blob store to the project (Storage
# tab -> Create Database -> Blob). For local dev, copy the value from the
# Vercel dashboard's project settings -> Environment Variables, or run
# `vercel env pull .env` after linking the project.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxx"
